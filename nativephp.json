{
    "namespace": "SocialLogin",
    "description": "OAuth 2.0 + PKCE in the system browser: ASWebAuthenticationSession on iOS, Custom Tabs on Android",
    "keywords": ["oauth", "oauth2", "pkce", "oidc", "social-login", "linkedin", "x", "github"],
    "category": "authentication",
    "license": "MIT",
    "pricing": {
        "type": "free"
    },
    "platforms": ["android", "ios"],
    "bridge_functions": [
        {
            "name": "SocialLogin.OpenAuthSession",
            "ios": "SocialLoginFunctions.OpenAuthSession",
            "android": "dev.franciscodlx.nativephp.sociallogin.SocialLoginFunctions.OpenAuthSession",
            "description": "Opens the authorization URL in the system browser; answers with AuthSessionCompleted or AuthSessionFailed"
        },
        {
            "name": "SocialLogin.CancelAuthSession",
            "ios": "SocialLoginFunctions.CancelAuthSession",
            "android": "dev.franciscodlx.nativephp.sociallogin.SocialLoginFunctions.CancelAuthSession",
            "description": "Dismisses the browser of the sign-in in progress"
        }
    ],
    "events": [
        "Franciscodlxdev\\SocialLogin\\Events\\AuthSessionCompleted",
        "Franciscodlxdev\\SocialLogin\\Events\\AuthSessionFailed"
    ],
    "android": {
        "min_version": 24,
        "dependencies": {
            "implementation": ["androidx.browser:browser:1.9.0"]
        },
        "activities": [
            {
                "name": "dev.franciscodlx.nativephp.sociallogin.AuthSessionActivity",
                "exported": false,
                "launchMode": "singleTask",
                "theme": "@android:style/Theme.Translucent.NoTitleBar",
                "configChanges": "keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
            },
            {
                "name": "dev.franciscodlx.nativephp.sociallogin.AuthRedirectActivity",
                "exported": true,
                "theme": "@android:style/Theme.Translucent.NoTitleBar"
            }
        ]
    },
    "ios": {
        "min_version": "15.0"
    },
    "service_provider": "Franciscodlxdev\\SocialLogin\\SocialLoginServiceProvider",
    "hooks": {
        "post_compile": "social-login:android-redirect-schemes"
    }
}
